{
  "name": "cofdesk-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "node scripts/licenses.ts && tsc --noEmit && vite build",
    "licenses": "node scripts/licenses.ts",
    "start": "node --env-file-if-exists=.env server/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.1",
    "ws": "^8.18.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "4.3.4",
    "axe-core": "^4.10.2",
    "concurrently": "^9.1.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
