# Copie para .env e preencha. O servidor lê este arquivo ao iniciar (reinicie depois de mudar).

# Endereço público do CofDesk. Em desenvolvimento: http://localhost:5173. Em produção: https://seu-dominio.com
PUBLIC_URL=http://localhost:5173

# Atrás de um proxy reverso (Nginx, Cloudflare, Render…), use 1 para registrar o IP real do visitante nos registros de acesso.
TRUST_PROXY=0

# Chave para criptografar tokens e senhas de app guardados no banco. Obrigatória em produção.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COFDESK_SECRET=

# Login com Google e Google Agenda — Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth (Aplicativo da Web)
# URI de redirecionamento autorizado: {PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Envio de e-mails (código de confirmação do cadastro). Qualquer SMTP serve: Google Workspace/Gmail, Resend, SendGrid, Amazon SES…
# Sem SMTP_HOST, em desenvolvimento o e-mail aparece no terminal do servidor; em produção o cadastro por e-mail fica indisponível.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CofDesk <nao-responda@seu-dominio.com>

# IA (fase 5, desativada por enquanto)
ANTHROPIC_API_KEY=
